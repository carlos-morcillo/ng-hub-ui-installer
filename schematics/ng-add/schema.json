{
	"$schema": "http://json-schema.org/schema",
	"$id": "NgHubUiNgAddSchema",
	"title": "ng-hub-ui ng-add options",
	"type": "object",
	"properties": {
		"libraries": {
			"type": "array",
			"description": "ng-hub-ui libraries to install.",
			"items": {
				"type": "string",
				"enum": [
					"avatar",
					"badges",
					"board",
					"breadcrumbs",
					"buttons",
					"calendar",
					"ds",
					"forms",
					"history",
					"icons",
					"loading",
					"metrics",
					"milestones",
					"modal",
					"nav",
					"paginable",
					"panels",
					"portal",
					"signature",
					"skeleton",
					"sortable",
					"stepper",
					"toast",
					"utils"
				]
			},
			"x-prompt": {
				"message": "Which ng-hub-ui libraries do you want to install?",
				"type": "list",
				"multiselect": true,
				"items": [
					{ "value": "avatar", "label": "Avatar" },
					{ "value": "badges", "label": "Badges & Chips" },
					{ "value": "board", "label": "Board (Kanban)" },
					{ "value": "breadcrumbs", "label": "Breadcrumbs" },
					{ "value": "buttons", "label": "Buttons (FAB, speed dial, dropdown)" },
					{ "value": "calendar", "label": "Calendar" },
					{ "value": "ds", "label": "Design Tokens (ds)" },
					{ "value": "forms", "label": "Forms" },
					{ "value": "history", "label": "History (undo/redo)" },
					{ "value": "icons", "label": "Icons" },
					{ "value": "loading", "label": "Loading (spinners & overlays)" },
					{ "value": "metrics", "label": "Metrics (progress, meter, gauge)" },
					{ "value": "milestones", "label": "Milestones (timeline)" },
					{ "value": "modal", "label": "Modal" },
					{ "value": "nav", "label": "Nav" },
					{ "value": "paginable", "label": "Paginable (table & list)" },
					{ "value": "panels", "label": "Panels (tabs, pills, accordion)" },
					{ "value": "portal", "label": "Portal" },
					{ "value": "signature", "label": "Signature" },
					{ "value": "skeleton", "label": "Skeleton" },
					{ "value": "sortable", "label": "Sortable" },
					{ "value": "stepper", "label": "Stepper" },
					{ "value": "toast", "label": "Toast" },
					{ "value": "utils", "label": "Utils" }
				]
			}
		},
		"skipInstall": {
			"type": "boolean",
			"description": "Skip package manager installation after package.json is updated.",
			"default": false
		}
	},
	"required": ["libraries"]
}
